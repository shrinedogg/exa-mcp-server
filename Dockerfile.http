# Build stage — compile TypeScript sources for both stdio and HTTP transports
FROM node:20-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts

COPY src/ ./src/
COPY tsconfig.json ./
# Build both stdio (for original Dockerfile compatibility) and http (for kagent)
RUN npm run build:stdio && npm run build:http
# Fail fast if either bundle is missing/empty. esbuild can exit 0 while
# producing no/empty output on some misconfigurations; this guards against
# silently shipping an image whose ENTRYPOINT (dist/http.cjs) doesn't exist.
RUN test -s dist/http.cjs && test -s dist/stdio.cjs

# Runner stage — serve over Streamable HTTP (kagent/RemoteMCPServer)
FROM node:20-alpine

WORKDIR /app

# Copy compiled HTTP transport (esbuild-bundled, no TypeScript deps needed at runtime)
COPY --from=builder /app/dist/http.cjs ./dist/http.cjs

# Production dependencies (agnost, exa-js, zod, etc.)
COPY package.json package-lock.json ./
RUN npm ci --production --ignore-scripts

# Expose MCP endpoint
EXPOSE 3000

# Health check — /health lives on the same port as MCP
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:3000/health || exit 1

# Run the HTTP transport entry point
ENTRYPOINT ["node", "dist/http.cjs"]
